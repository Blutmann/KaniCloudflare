{
  // Existing Worker serving the connected Kani website.
  // Nitro supplies main/assets in its generated deployment configuration.
  "name": "kanibarberstudio-cloudflare",
  "keep_vars": true,
  // Preview bindings and secrets stay in the existing Cloudflare Previews Base.
  "previews": {},
  "assets": {
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "KANI_CANONICAL_HOST": "www.kanibarber.com",
    "SUPABASE_URL": "https://iockpxtkflyjfagkvgnr.supabase.co",
    "RESEND_FROM_EMAIL": "Kani Barber <noresponder@kanibarber.com>",
    "RESEND_BARBER_FROM_EMAIL": "Kani Barber <turnos@kanibarber.com>",
    "PAYWAY_SANDBOX_ENABLED": "false",
    "PAYWAY_PRODUCTION_ENABLED": "true",
    "PAYWAY_ENVIRONMENT": "production",
    "PAYWAY_API_BASE_URL": "https://ventasonline.payway.com.ar/api/v2",
    "PAYWAY_PAYMENT_METHODS": "[{\"id\":1,\"label\":\"Visa\"},{\"id\":104,\"label\":\"Mastercard\"},{\"id\":63,\"label\":\"Cabal\"}]",
    "PONTIUN_PHONE_NUMBER_ID": "1391432264052937",
    "PONTIUN_WABA_ID": "1519852186644295",
    "PONTIUN_TEMPLATE_NAME": "confirmacion_turno_kani",
    "PONTIUN_TEMPLATE_LANGUAGE": "es_AR",
    "GOOGLE_CALENDAR_SYNC_ENABLED": "true"
  }
}
