# Public Supabase configuration. These values are safe for the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backward-compatible alias for Supabase projects using the new naming.
# Use either VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY.
# VITE_SUPABASE_PUBLISHABLE_KEY=

# WhatsApp Cloud API (Meta Developers)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=confirmacion_turno_kani

# Mercado Pago (Orders API & Webhook)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Payway experimental laboratory: sandbox only. Never prefix private keys with VITE_.
# Explicit gate: configuring keys alone never enables charges.
PAYWAY_SANDBOX_ENABLED=false
PAYWAY_ENVIRONMENT=sandbox
# Choose the sandbox host confirmed by Payway, including /api/v2. No production URL.
PAYWAY_API_BASE_URL=
PAYWAY_PUBLIC_API_KEY=
PAYWAY_PRIVATE_API_KEY=
PAYWAY_SITE_ID=
# Backend-only Cloudflare Secret, at least 32 random characters; encrypted checkout cookie.
PAYWAY_CHECKOUT_SECRET=
# JSON array of enabled official payment methods: objects with numeric id and label.
PAYWAY_PAYMENT_METHODS=[]
# Template ID is intentionally unused: direct tokenization does not require it.

