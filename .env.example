# Public Supabase configuration. These values are safe for the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backward-compatible alias for Supabase projects using the new naming.
# Use either VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY.
# VITE_SUPABASE_PUBLISHABLE_KEY=

# WhatsApp Cloud API / Pontiun
PONTIUN_API_KEY=
PONTIUN_WEBHOOK_SECRET=
PONTIUN_PHONE_NUMBER_ID=1443960902134586
PONTIUN_WABA_ID=1583968350170301
PONTIUN_TEMPLATE_NAME=kani_barber_confirmacion_turno
PONTIUN_TEMPLATE_LANGUAGE=es_AR
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=kani_barber_confirmacion_turno

# Mercado Pago (Orders API & Webhook)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Payway: explicit server-side environment. Never prefix private keys with VITE_.
# Explicit gate: configuring keys alone never enables charges.
PAYWAY_SANDBOX_ENABLED=false
PAYWAY_PRODUCTION_ENABLED=false
PAYWAY_ENVIRONMENT=sandbox
# Sandbox: https://developers-ventasonline.payway.com.ar/api/v2
# Production: https://ventasonline.payway.com.ar/api/v2
# Production requires PRODUCTION_ENABLED=true, SANDBOX_ENABLED=false and environment=production.
PAYWAY_API_BASE_URL=
PAYWAY_PUBLIC_API_KEY=
PAYWAY_PRIVATE_API_KEY=
PAYWAY_SITE_ID=
# Backend-only Cloudflare Secret, at least 32 random characters; mandatory in production.
PAYWAY_CHECKOUT_SECRET=
# JSON array of enabled official payment methods: objects with numeric id and label.
PAYWAY_PAYMENT_METHODS=[]
# Template ID is intentionally unused: direct tokenization does not require it.

